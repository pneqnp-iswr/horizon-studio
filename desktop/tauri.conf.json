{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Horizon Studio",
  "mainBinaryName": "HorizonStudio",
  "identifier": "io.github.pneqnp-iswr.horizonstudio",
  "build": {
    "frontendDist": "splash"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Horizon Studio Contributors",
    "copyright": "MIT License, Horizon Studio Contributors. Unofficial; not affiliated with Mojang, Microsoft or the Horizon developers.",
    "shortDescription": "Unofficial visual mod editor for the Horizon engine",
    "category": "DeveloperTool",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Russian"],
        "displayLanguageSelector": true
      }
    }
  }
}
